{
  "name": "x-texas-holdem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 2011",
    "build": "next build",
    "build:aliyun": "cross-env NEXT_PUBLIC_BASE_PATH=/texas-holdem next build",
    "start": "next start",
    "lint": "eslint",
    "test:random": "node --import tsx tests/test-random.ts",
    "test:scenarios": "node --import tsx tests/test-scenarios.ts",
    "test:unit": "node --import tsx tests/test-poker-engine.ts",
    "test:equity": "node --import tsx tests/test-win-rate.ts",
    "test:battle": "node --import tsx tests/test-ai-battle.ts --games=50 --sims=1000",
    "test:training": "node --import tsx tests/test-training.ts",
    "test:tune": "node --import tsx tests/tune-super-ai.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.26.1"
}
